# Mini NotebookLM — frontend development config.
#
# Demo mode auto-provisions a local "demo-user" session on startup so the
# workspace loads immediately without a login screen.
#   - In dev (`npm run dev`) Vite sets DEV=true, so demo mode is active by
#     default even without this file.
#   - This flag makes the intent explicit and also enables demo mode if the
#     dev server is ever started via a custom command.
#
# To disable demo mode and require real authentication, set this to false
# (or build/serve for production, which is false by default).
VITE_DEMO_MODE=true
